@app.route("/reports")
@login_required
def reports():
    conn = get_db()
    rows = conn.execute(
        "SELECT * FROM transactions WHERE user_id = ? ORDER BY date ASC",
        (current_user.id,),
    ).fetchall()
    conn.close()

    monthly = {}
    for t in rows:
        month = t["date"][:7]  # 'YYYY-MM'
        monthly.setdefault(month, {"income": 0, "expense": 0})
        if t["group_name"] == "income":
            monthly[month]["income"] += t["amount"]
        elif t["group_name"] in ("fixed_expense", "variable_expense"):
            monthly[month]["expense"] += t["amount"]

    months_sorted = sorted(monthly.keys())[-6:]
    trend_labels = months_sorted
    trend_income = [monthly[m]["income"] for m in months_sorted]
    trend_expense = [monthly[m]["expense"] for m in months_sorted]

    this_month = date.today().strftime("%Y-%m")
    this_month_tx = get_month_transactions(current_user.id, this_month)
    _, category_totals = summarize(this_month_tx)

    return render_template(
        "reports.html",
        trend_labels=trend_labels,
        trend_income=trend_income,
        trend_expense=trend_expense,
        category_totals=category_totals,
    )


