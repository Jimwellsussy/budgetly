# ------------------------------------------------------------
# BUDGET vs ACTUAL
# ------------------------------------------------------------

@app.route("/budget", methods=["GET", "POST"])
@login_required
def budget():
    this_month = date.today().strftime("%Y-%m")

    if request.method == "POST":
        category = request.form.get("category")
        amount = request.form.get("budget_amount")
        try:
            amount = float(amount)
        except (TypeError, ValueError):
            amount = 0

        if category and amount > 0:
            conn = get_db()
            # UPSERT: update if a budget for this category+month already
            # exists, otherwise insert a new one.
            conn.execute("""
                INSERT INTO budgets (user_id, category, month, budget_amount)
                VALUES (?, ?, ?, ?)
                ON CONFLICT(user_id, category, month)
                DO UPDATE SET budget_amount = excluded.budget_amount
            """, (current_user.id, category, this_month, amount))
            conn.commit()
            conn.close()
        return redirect(url_for("budget"))

    conn = get_db()
    budget_rows = conn.execute(
        "SELECT * FROM budgets WHERE user_id = ? AND month = ?",
        (current_user.id, this_month),
    ).fetchall()
    conn.close()

    transactions = get_month_transactions(current_user.id, this_month)
    _, actual_by_category = summarize(transactions)

    comparison = []
    for b in budget_rows:
        actual = actual_by_category.get(b["category"], 0)
        comparison.append({
            "category": b["category"],
            "budget": b["budget_amount"],
            "actual": actual,
            "difference": b["budget_amount"] - actual,
        })

    all_expense_categories = CATEGORY_GROUPS["fixed_expense"] + CATEGORY_GROUPS["variable_expense"]
    already_budgeted = [b["category"] for b in budget_rows]

    return render_template(
        "budget.html",
        comparison=comparison,
        all_expense_categories=all_expense_categories,
        already_budgeted=already_budgeted,
        this_month=this_month,
    )


