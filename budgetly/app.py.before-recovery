# ------------------------------------------------------------
# PASSWORD RULES
# ------------------------------------------------------------
# Regex for allowed special characters. Kept in one place so the
# error message and the check always agree with each other.
SPECIAL_CHARS = ".!@#$%^&*"
EMAIL_PATTERN = re.compile(r"^[^@\s]+@[^@\s]+\.[^@\s]+$")


def validate_password(password, username=None):
    """Returns a list of human-readable error strings. Empty list = valid.

    Rules:
      - at least 8 characters
      - at least 1 uppercase letter
      - at least 1 lowercase letter
      - at least 1 number
      - at least 1 special character (! @ # $ % ^ & *)
      - cannot contain the username
      - cannot contain spaces
    """
    errors = []

    if len(password) < 8:
        errors.append("Password must be at least 8 characters long.")
    if not re.search(r"[A-Z]", password):
        errors.append("Password must contain at least 1 uppercase letter.")
    if not re.search(r"[a-z]", password):
        errors.append("Password must contain at least 1 lowercase letter.")
    if not re.search(r"[0-9]", password):
        errors.append("Password must contain at least 1 number.")
    if not any(ch in SPECIAL_CHARS for ch in password):
        errors.append(f"Password must contain at least 1 special character ({' '.join(SPECIAL_CHARS)}).")
    if " " in password:
        errors.append("Password cannot contain spaces.")
    if username and username.strip().lower() in password.lower():
        errors.append("Password cannot contain your username.")

    return errors


def is_password_previously_used(conn, user_id, password):
    """Checks a plaintext password against all hashes ever stored for this user."""
    rows = conn.execute(
        "SELECT password_hash FROM password_history WHERE user_id = ?",
        (user_id,),
    ).fetchall()
    return any(check_password_hash(row["password_hash"], password) for row in rows)


def record_password(conn, user_id, password_hash):
    """Saves a hash into password_history so future changes can check against it."""
    conn.execute(
        "INSERT INTO password_history (user_id, password_hash, created_at) VALUES (?, ?, ?)",
        (user_id, password_hash, datetime.utcnow().isoformat()),
    )


# ------------------------------------------------------------
# PASSWORD RESET TOKENS
# ------------------------------------------------------------
# The token encodes the user's email PLUS their current password hash.
# That second part is what makes the link single-use: once the password
# is actually changed, the stored hash no longer matches what's inside
# an old token, so replaying that link fails even though the 1-hour
# expiry window hasn't passed yet.

def generate_reset_token(email, current_password_hash):
    return reset_serializer.dumps(
        {"email": email, "hash": current_password_hash}, salt=RESET_SALT
    )


def verify_reset_token(token, max_age=RESET_TOKEN_MAX_AGE):
    """Returns (email, hash_at_time_of_request). Raises SignatureExpired
    or BadSignature if the token is expired/invalid — callers must catch these."""
    data = reset_serializer.loads(token, salt=RESET_SALT, max_age=max_age)
    return data["email"], data["hash"]


def send_reset_email(to_email, reset_url):
    msg = Message("Reset your Budgetly password", recipients=[to_email])
    msg.body = (
        "We received a request to reset your Budgetly password.\n\n"
        f"Click the link below to choose a new one (expires in 1 hour):\n{reset_url}\n\n"
        "If you didn't request this, you can safely ignore this email — "
        "your password will not be changed."
    )
    mail.send(msg)


# ------------------------------------------------------------
# DATABASE HELPERS
# ------------------------------------------------------------

def get_db():
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA foreign_keys = ON")
    return conn


def init_db():
    conn = get_db()
    conn.execute("""
        CREATE TABLE IF NOT EXISTS users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            username TEXT UNIQUE NOT NULL,
            email TEXT UNIQUE NOT NULL,
            password_hash TEXT NOT NULL
        )
    """)
    conn.execute("""
        CREATE TABLE IF NOT EXISTS password_history (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER NOT NULL,
            password_hash TEXT NOT NULL,
            created_at TEXT NOT NULL,
            FOREIGN KEY (user_id) REFERENCES users(id)
        )
    """)
    conn.execute("""
        CREATE TABLE IF NOT EXISTS transactions (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER NOT NULL,
            group_name TEXT NOT NULL,       -- income / fixed_expense / variable_expense / savings
            category TEXT NOT NULL,
            description TEXT,
            amount REAL NOT NULL,
            payment_method TEXT,
            date TEXT NOT NULL,
            FOREIGN KEY (user_id) REFERENCES users(id)
        )
    """)
    conn.execute("""
        CREATE TABLE IF NOT EXISTS goals (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER NOT NULL,
            name TEXT NOT NULL,
            target REAL NOT NULL,
            saved REAL NOT NULL DEFAULT 0,
            FOREIGN KEY (user_id) REFERENCES users(id)
        )
    """)
    conn.execute("""
        CREATE TABLE IF NOT EXISTS budgets (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER NOT NULL,
            category TEXT NOT NULL,
            month TEXT NOT NULL,             -- format: YYYY-MM
            budget_amount REAL NOT NULL,
            FOREIGN KEY (user_id) REFERENCES users(id),
            UNIQUE(user_id, category, month)
        )
    """)
    conn.commit()
    conn.close()


def migrate_db():
    """Adds columns/tables needed by newer versions of the app to an
    already-existing budgetly.db, without deleting your current data.
    Safe to run every time the app starts."""
    conn = get_db()
    existing_cols = [row["name"] for row in conn.execute("PRAGMA table_info(users)").fetchall()]
    if "email" not in existing_cols:
        # Added as plain TEXT (not UNIQUE/NOT NULL) because SQLite can't add
        # a NOT NULL/UNIQUE column to a table that already has rows.
        # Uniqueness for email is instead enforced in the /register route.
        conn.execute("ALTER TABLE users ADD COLUMN email TEXT")
        conn.commit()
    conn.close()


# ------------------------------------------------------------
# USER MODEL (required by Flask-Login)
# ------------------------------------------------------------
class User(UserMixin):
    """Flask-Login needs an object with an .id — this wraps our DB row."""
    def __init__(self, id, username, email=None):
        self.id = id
        self.username = username
        self.email = email


@login_manager.user_loader
def load_user(user_id):
    """Flask-Login calls this on every request to figure out who's
    logged in, using the id stored in the encrypted session cookie."""
    conn = get_db()
    row = conn.execute("SELECT * FROM users WHERE id = ?", (user_id,)).fetchone()
    conn.close()
    if row:
        return User(row["id"], row["username"], row["email"])
    return None


